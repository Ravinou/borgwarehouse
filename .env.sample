##  This is a sample, adapt it.
##  Full documentation: https://borgwarehouse.com/docs/admin-manual/env-vars/

###############################################################################
##                            REQUIRED VARIABLES                             ##
###############################################################################

## Host port mappings (published by docker-compose) ##
# Web UI port on the host -> container's :3000
WEB_SERVER_PORT=3000
# SSH port on the host -> container's :22 (used by Borg clients)
SSH_SERVER_PORT=2222

## Volume mount paths on the host ##
# These host directories must be owned by the PUID:PGID set below.
CONFIG_PATH=./config
SSH_PATH=./ssh
SSH_HOST=./ssh_host
BORG_REPOSITORY_PATH=./repos

## User / group the app runs as inside the container ##
# Must match the owner of the volume directories above. Must be > 0 (root is not allowed).
PUID=1000
PGID=1000

## Public hostname / URL ##
# FQDN shown to users in the generated backup commands.
FQDN=your.domain.com
# Full base URL of your instance. The scheme (http/https) MUST match how you access it.
BETTER_AUTH_URL=https://your.domain.com

## Authentication secret ##
# Generate with: openssl rand -base64 32
# If omitted, a new random secret is generated at every restart, logging out all users.
BETTER_AUTH_SECRET=your-secret

## Cron / scheduled tasks ##
# Key used to trigger the status & storage jobs from outside the container.
# Auto-generated if not set (but then unknown to you). Set it if you use an external cron.
# Generate with: openssl rand -base64 32
CRONJOB_KEY=your-other-secret

###############################################################################
##                            OPTIONAL VARIABLES                             ##
###############################################################################

## First-run setup protection (>= v3.2.0) ##
# Passphrase required to complete the /setup wizard on publicly exposed instances.
#SETUP_SECRET=

## Session lifetime, in seconds (>= v3.2.0). Default: 3600 (1 hour). ##
#SESSION_EXPIRY_SECONDS=3600

## Extra trusted origins for reverse-proxy / multi-domain setups (>= v3.2.0) ##
# Comma-separated list of origins.
#BETTER_AUTH_TRUSTED_ORIGINS=https://bw.example.com,https://bw.local

## LAN feature: alternate hostname/port for backups over the local network ##
#FQDN_LAN=
#SSH_SERVER_PORT_LAN=

## Server user used in generated commands. Default: borgwarehouse ##
#UNIX_USER=borgwarehouse

## Hide the SSH port in the UI (quickcommands & wizard) (>= v2.4.0) ##
#HIDE_SSH_PORT=true

## Feature toggles ##
# Disable the integrations (API tokens to CRUD repositories) (>= v2.4.0)
#DISABLE_INTEGRATIONS=true
# Globally disable deleting a repository (>= v2.4.0)
#DISABLE_DELETE_REPO=true
# Globally disable compacting a repository (>= v3.6.0)
#DISABLE_COMPACT_REPO=true

## Number of repo.json config history snapshots kept in config/versions/. Default: 8 ##
#MAX_REPO_BACKUP_COUNT=8

## Force the app to start on IPv6 if needed ##
#HOSTNAME=::

## Disable Next.js telemetry ##
#NEXT_TELEMETRY_DISABLED=1

## External storage targets ##
# Comma-separated absolute paths to already-mounted storages, selectable per repository in the UI.
# An optional display name can be added to each entry with the "path|name" syntax.
# See: https://borgwarehouse.com/docs/admin-manual/external-storage/
#STORAGE_TARGETS=/mnt/nas|Home NAS,/mnt/backup-disk

## SMTP (email notifications) ##
# See: https://borgwarehouse.com/docs/admin-manual/smtp-configuration/
#MAIL_SMTP_FROM=
#MAIL_SMTP_HOST=
#MAIL_SMTP_PORT=
#MAIL_SMTP_LOGIN=
#MAIL_SMTP_PWD=
# Accept self-signed TLS certificates (true/false)
#MAIL_REJECT_SELFSIGNED_TLS=

## OAuth / OIDC single sign-on ##
# See: https://borgwarehouse.com/docs/admin-manual/oauth-oidc/
# Disable username/password login (OAuth-only mode) - only valid if a provider below is configured (>= v3.2.0)
#DISABLE_PASSWORD_LOGIN=true

# GitHub
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=

# Google
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# Microsoft (MICROSOFT_TENANT_ID is optional)
#MICROSOFT_CLIENT_ID=
#MICROSOFT_CLIENT_SECRET=
#MICROSOFT_TENANT_ID=

# GitLab
#GITLAB_CLIENT_ID=
#GITLAB_CLIENT_SECRET=

# Generic OIDC provider (Authentik, Keycloak, Zitadel, ...)
# Requires OIDC_CLIENT_ID, OIDC_CLIENT_SECRET and OIDC_ISSUER_URL.
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_ISSUER_URL=
# Display name of the SSO button (defaults to "SSO")
#OIDC_PROVIDER_NAME=
